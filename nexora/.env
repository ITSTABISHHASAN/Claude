# Brand tokens. Vite substitutes %VITE_*% in the HTML at build time and exposes
# them to scripts via import.meta.env, so a rename is a one-line change.
VITE_BRAND=NEXORA
VITE_BRAND_LEGAL=NEXORA Labs, Inc.
VITE_TAGLINE=The operating system for autonomous business.
VITE_DESCRIPTION=NEXORA deploys AI agents that route, reconcile and report across your stack, so your team spends its time on decisions instead of busywork.
VITE_SITE_URL=https://nexora.ai
